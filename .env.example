# Copy to .env and fill in. The real .env is gitignored; this file is not, so
# never put a real key or password here.
#
# A real environment variable always beats what this file says, so pointing a
# single run somewhere else needs no edit:
#
#     NEO4J_URI=bolt://other-host:7687 py main.py --check

# ---- stage 1: data-acquisition ----
# Free key: https://nvd.nist.gov/developers/request-an-api-key
# Without one NVD allows 5 requests per 30s instead of 50 -- about 10x slower.
NVD_API_KEY=

# ---- stage 3: data-loading ----
# Required. Whatever the database was created with -- on a tarball install,
# what `neo4j-admin dbms set-initial-password` was given before first start.
NEO4J_PASSWORD=

# Optional; these are the defaults, shown so you know they exist.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_DATABASE=neo4j

# Optional, for the ingest API only. Unset leaves POST /ingest open, which is
# what the loopback-plus-SSH-tunnel deployment wants. Set it before binding the
# API to anything other than 127.0.0.1 -- see data-loading/README.md.
# INGEST_API_KEY=

# ---- stage 4, data-extraction/ (all optional; defaults shown) ----
# OLLAMA_URL=http://127.0.0.1:11434
# EXTRACT_MODEL=qwen3:32b
# EMBED_MODEL=bge-m3
# EMBED_DIMENSIONS=1024
# Raw cosine. The paper's 0.9 was tuned for its own embedder; with bge-m3 the
# calibrated value on the gold set is 0.55 (see data-extraction/README.md).
# ALIGN_THRESHOLD=0.9
# EXTRACT_THINK=false
# EXTRACT_WORKERS=1
# INGEST_URL=http://127.0.0.1:8000
